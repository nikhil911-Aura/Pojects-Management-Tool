generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum MemberStatus {
  INVITED
  ACTIVE
}

// Project-level role — separate from workspace role
// Editor: full read/write within the project
// Commenter: can view + comment, cannot edit tasks or sections
// Viewer: read-only, cannot comment or edit
enum ProjectRole {
  EDITOR
  COMMENTER
  VIEWER
}

// Models
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  workspaces    WorkspaceMember[]
  projectMembers ProjectMember[]
  assignedTasks TaskAssignee[]
  comments      Comment[]
  activityLogs  ActivityLog[]
  attachments   Attachment[]
  invitesSent   WorkspaceInvite[]

  // Refresh tokens
  refreshToken  String?
  refreshTokenExp DateTime?
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  members     WorkspaceMember[]
  projects    Project[]
  tags        Tag[]
  invites     WorkspaceInvite[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  role        Role         @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model WorkspaceInvite {
  id          String       @id @default(uuid())
  email       String
  role        Role         @default(MEMBER)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([workspaceId])
}

model Project {
  id          String           @id @default(uuid())
  name        String
  description String?
  icon        String?
  color       String?
  views       String[]          @default(["overview", "list", "board", "timeline", "dashboard"])
  visibility  ProjectVisibility @default(PRIVATE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board        Board?
  members      ProjectMember[]
  customFields CustomField[]

  @@index([workspaceId])
}

enum FieldType {
  TEXT
  NUMBER
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  PEOPLE
  CHECKBOX
  TIME_TRACKING
}

model CustomField {
  id        String    @id @default(uuid())
  name      String
  type      FieldType @default(TEXT)
  options   Json?     // for SELECT types: [{ value, color }]
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@index([projectId])
}

model CustomFieldValue {
  id        String   @id @default(uuid())
  value     String?  // stores text, number as string, select option value, date ISO, etc.

  fieldId   String
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([fieldId, taskId])
  @@index([fieldId])
  @@index([taskId])
}

model ProjectMember {
  id          String      @id @default(uuid())
  role        Role        @default(MEMBER)        // kept for compat, not used for permission checks
  projectRole ProjectRole @default(EDITOR)        // actual permission level within the project
  createdAt   DateTime    @default(now())

  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Board {
  id         String   @id @default(uuid())
  name       String   @default("Board")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lists     List[]

  @@index([projectId])
}

model List {
  id        String   @id @default(uuid())
  name      String
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([boardId])
}

enum TaskType {
  DEFAULT_TASK
  MILESTONE
  APPROVAL
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  taskType    TaskType   @default(DEFAULT_TASK)
  status      TaskStatus @default(TODO)
  priority    Priority   @default(LOW)
  dueDate       DateTime?
  estimatedTime Int?       // estimated time in minutes
  actualTime    Int?       // actual time in minutes
  position      Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  listId      String
  list        List       @relation(fields: [listId], references: [id], onDelete: Cascade)
  
  // Self-relation for subtasks
  parentId    String?
  parent      Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("Subtasks")

  assignees        TaskAssignee[]
  comments         Comment[]
  activityLogs     ActivityLog[]
  attachments      Attachment[]
  tags             Tag[]
  customFieldValues CustomFieldValue[]

  @@index([listId])
  @@index([parentId])
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  color       String    @default("#4573D2")
  createdAt   DateTime  @default(now())
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  tasks       Task[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
}

model TaskAssignee {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  createdAt DateTime @default(now())

  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
}

model Attachment {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  // Relations
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
}
