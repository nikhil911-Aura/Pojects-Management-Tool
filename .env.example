# Copy this file to .env.development (for local) or .env.production (for server)
# then run: start-dev.bat / start-prod.bat (Windows) or ./start-dev.sh / ./start-prod.sh (Linux)

NODE_ENV=production

# ── Database (external) ───────────────────────────────────────────────────────
# Windows/Mac Docker Desktop: use host.docker.internal
# Linux server: use host.docker.internal (supported via extra_hosts in compose)
DATABASE_URL=postgresql://user:password@host.docker.internal:5432/dbname

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRE=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
# Set to the host:port where the frontend is accessed from the browser
# Dev:  http://localhost:3000
# Prod: http://173.212.217.118:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Cloudinary (file uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (email notifications) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
